# IMPD public component - what enters the repository
#
# Allow-list: everything is ignored unless listed here. The DANS deposits (Surveys/*.zip), everything built from
# them (data/), and working folders never enter the repository, however a file is named.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/code/
!/crosswalks/
!/docs/
!/External/
!/Surveys/
/Surveys/*
!/Surveys/Sources.txt

# Data formats are never tracked, wherever they appear (belt and braces for the allow-list above)
*.dta
*.rds
*.RData
*.sav
*.por
*.zip
*.parquet

# Derived copies and run logs, regenerated by the pipelines (Word copies: code/tools/md_to_word.py; PowerPoint
# decks: code/tools/make_deck.py, from docs/slides/*.md; Stata-side codebook log: code/Stata/05_codebook.do, which records the local path and a timestamp)
/docs/word/
/docs/slides/*.pptx
/docs/codebook_stata.txt

# Editor and OS clutter
__pycache__/
*.pyc
.Rhistory
.Rproj.user/
~$*
.DS_Store
Thumbs.db
desktop.ini

