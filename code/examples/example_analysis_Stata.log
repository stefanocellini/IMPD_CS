. do "code/Stata/impd_tools.do"

. * impd_tools.do : helpers for analyses of the IMPD-CS file (not part of the build).
. *   do code/Stata/impd_tools.do
. *   use data/derived/impd_cs_v0_4_6.dta, clear
. *   impd_sample dem_sex dem_age_cat3 edu_dipl_hi_lvl3 lab_emp
. *
. * impd_sample varlist [, surveys(numlist) nostop]
. *   Model-level eligibility report: per survey, the number of records with a valid value on every variable in varlist, and
. *   why records drop out (variables not collected .e, not applicable .c, item non-response .a .b .d .).  Exits with error 459
. *   when a survey ends with no complete record, unless nostop is given.  Results are left in r(): r(table) has one row per
. *   survey (svy_id, n_records, n_complete).
. capture program drop impd_sample

. program define impd_sample, rclass
  1.     syntax varlist(min=1) [, SURveys(numlist) noSTOP]
  2.     tempvar ok
  3.     quietly {
  4.         if "`surveys'" == "" levelsof svy_id, local(surveys)
  5.         gen byte `ok' = 1
  6.         foreach v of varlist `varlist' {
  7.             replace `ok' = 0 if missing(`v')
  8.         }
  9.     }
 10.     tempname T
 11.     local lost
 12.     display as text _n "impd_sample: `: word count `varlist'' variable(s)"
 13.     display as text %-10s "survey" %10s "records" %10s "complete" %8s "share" "  not collected"
 14.     foreach s of local surveys {
 15.         quietly count if svy_id == `s'
 16.         local n = r(N)
 17.         quietly count if svy_id == `s' & `ok'
 18.         local nc = r(N)
 19.         local nocol
 20.         local det
 21.         foreach v of varlist `varlist' {
 22.             quietly count if svy_id == `s' & `v' == .e
 23.             if r(N) == `n' & `n' > 0 local nocol "`nocol' `v'"
 24.             quietly count if svy_id == `s' & !missing(`v')
 25.             local nv = r(N)
 26.             quietly count if svy_id == `s' & `v' == .c
 27.             local ncc = r(N)
 28.             quietly count if svy_id == `s' & `v' == .e
 29.             local ne = r(N)
 30.             local no = `n' - `nv' - `ncc' - `ne'
 31.             local det "`det' `v': `nv' valid / `ncc' .c / `ne' .e / `no' other |"
 32.         }
 33.         local lab : label (svy_id) `s'
 34.         local share = cond(`n' > 0, `nc' / `n', .)
 35.         display as text %-10s "`lab'" as result %10.0f `n' %10.0f `nc' %8.3f `share' as text "  `nocol'"
 36.         display as text "     `det'"
 37.         capture confirm matrix `T'
 38.         if _rc matrix `T' = (`s', `n', `nc')
 39.         else matrix `T' = `T' \ (`s', `n', `nc')
 40.         if `nc' == 0 local lost "`lost' `lab'"
 41.     }
 42.     matrix colnames `T' = svy_id n_records n_complete
 43.     return matrix table = `T'
 44.     return local lost "`lost'"
 45.     if "`lost'" != "" {
 46.         if "`stop'" != "nostop" {
 47.             display as error "survey(s) with no complete record on `varlist':`lost'"
 48.             exit 459
 49.         }
 50.         else display as text "warning: survey(s) with no complete record on `varlist':`lost'"
 51.     }
 52. end

. 
end of do-file

